METALPRICEAPI_API_KEY=replace_me
METALPRICEAPI_BASE_URL=https://api.metalpriceapi.com
# Comma-separated ISO codes; one spot (/yesterday, historical, timeframe) request per base. Default when unset: USD only.
METALPRICEAPI_BASE_CURRENCIES=USD,CAD,AUD,EUR,GBP
# Set true or 1 to call GET /v1/ohlc (open_base…close_base). Default when unset: false.
METALPRICEAPI_ENABLE_OHLC=false
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_SCHEMA=xaulytics
SUPABASE_METAL_PRICES_TABLE=metal_prices_v1
SUPABASE_ETL_RUNS_TABLE=etl_runs_v1
SUPABASE_SYMBOLS_TABLE=metalprice_api_symbols_v1
LOG_LEVEL=INFO
# Calendar years before global max pricing_date to keep (dashboard 5y anchor). Rows strictly older are deleted by `xaulytics-etl retention`.
RETENTION_ANCHOR_YEARS=5
